# =============================================================
# rishirecruit2026 環境変数テンプレート
# -------------------------------------------------------------
# ローカル開発: このファイルを .env.local としてコピーして値を埋める
#   cp .env.example .env.local
#
# Vercel: Dashboard → Project → Settings → Environment Variables
#   に同じキーを Production / Preview / Development の 3 環境ぶん設定する
#
# 命名規約:
#   - NEXT_PUBLIC_* → クライアント(ブラウザ)へも露出する公開値
#   - それ以外       → サーバサイド専用のシークレット
# =============================================================

# ----- WordPress ヘッドレス連携 -----

# WPGraphQL エンドポイント
# 本番例: https://wp.rishirecruit.com/graphql
NEXT_PUBLIC_WP_GRAPHQL_URL=http://rishirecruit-2026.local/graphql

# WP のベース URL（管理画面リンク・画像 srcset 等に使用）
# 本番例: https://wp.rishirecruit.com
NEXT_PUBLIC_WP_BASE_URL=http://rishirecruit-2026.local

# Next.js 側の公開 URL（sitemap / OGP / canonical で使用）
# 本番例: https://www.rishirecruit.com  ← www あり継続
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# note の RSS フィード（コラム一覧で取り込む）
# 本番例: https://note.com/<account>/rss
NEXT_PUBLIC_NOTE_RSS_URL=

# ----- Contact Form 7 (WP プラグイン) の form ID -----

# 問い合わせフォーム
NEXT_PUBLIC_CF7_CONTACT_ID=176

# 求人応募フォーム
NEXT_PUBLIC_CF7_APPLY_ID=177

# ----- On-demand Revalidation -----

# WP 更新時に Next.js キャッシュを再検証するための共有シークレット。
# WordPress 側 mu-plugin (rishi-revalidate-config.php) の
#   RISHI_REVALIDATE_SECRET と同じ値にする。
# 発行例: openssl rand -hex 32
REVALIDATE_SECRET=REPLACE_WITH_RANDOM_32_HEX

# ----- Cloudflare Turnstile (bot 対策) -----

# サイトキー(公開値)。既定はローカル検証用の公式テストキー(常に成功)。
# 本番: https://dash.cloudflare.com/?to=/:account/turnstile で発行して差し替え
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# シークレット(サーバ専用)。本番用に差し替え必須。
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ----- Google Analytics 4 -----

# 測定 ID (G-XXXXXXXXXX)。未設定なら GA スクリプトを一切読み込まない。
# 本番でのみ設定推奨。開発環境では空のままで OK。
NEXT_PUBLIC_GA_ID=
